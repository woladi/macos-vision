{
  "name": "macos-vision",
  "version": "1.5.0",
  "description": "Apple Vision OCR + image/PDF analysis for Node.js, with optional Ollama-driven Markdown pipeline — native, fast, offline",
  "author": "Adrian Wolczuk",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "macos-vision": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./markdown": {
      "import": "./dist/markdown/index.js",
      "types": "./dist/markdown/index.d.ts"
    }
  },
  "files": [
    "dist",
    "scripts/install-native.js",
    "src/native",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woladi/macos-vision.git"
  },
  "scripts": {
    "build-native": "node scripts/build-native-cross.js",
    "postinstall": "node scripts/install-native.js",
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "prepare": "[ -d .git ] && husky || true",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish",
    "eval:install": "npm --prefix eval install",
    "eval:setup": "git clone https://github.com/opendataloader-project/opendataloader-bench eval/bench || echo 'bench already cloned'",
    "eval": "npm --prefix eval run eval",
    "eval:resume": "npm --prefix eval run eval:resume",
    "eval:quick": "npm --prefix eval run eval:quick",
    "eval:report": "npm --prefix eval run eval:report",
    "optimize-prompts": "npm --prefix eval run optimize-prompts"
  },
  "keywords": [
    "ocr",
    "macos",
    "apple-vision",
    "image",
    "text-extraction",
    "vision",
    "native",
    "offline",
    "face-detection",
    "barcode",
    "qr-code",
    "document-detection",
    "image-classification",
    "markdown",
    "image-to-markdown",
    "pdf-to-markdown",
    "ollama",
    "llm",
    "document-pipeline"
  ],
  "lint-staged": {
    "src/**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "os": [
    "darwin"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/node": "^20.0.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.58.0",
    "vitest": "^2.1.9"
  }
}
